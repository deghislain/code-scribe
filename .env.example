GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
POLL_INTERVAL_SECONDS=300

# Where cloned repositories are checked out.
# Set to an absolute path to use a shared workspace location, e.g.:
# Defaults to ./workspaces (relative to the project root).
WORKSPACE_DIR=./workspaces

OUTPUT_DIR=./outputs
DB_PATH=./code_scribe.db

# Port Code-Scribe's uvicorn process is listening on.
# The chat widget injected into target apps reads this to construct its
# default backend URL. Override if you run Code-Scribe on a non-standard port.
# e.g.: CODE_SCRIBE_PORT=8001
CODE_SCRIBE_PORT=8000
